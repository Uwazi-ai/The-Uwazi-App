{
  "id": "ai.uwazi.app",
  "name": "UWAZI.APP",
  "short_name": "UWAZI",
  "description": "Your civic co-pilot",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0a0a0a",
  "theme_color": "#84cc16",
  "orientation": "portrait-primary",
  "iarc_rating_id": "",
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+uwazi",
      "url": "/?q=%s"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://uwazi.ai"
    }
  ],
  "note_taking": {
    "new_note_url": "/ask"
  },
  "icons": [
    { "src": "/icons/icon-72x72.png", "sizes": "72x72", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-96x96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-128x128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-144x144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-152x152.png", "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-180x180.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-1024x1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "categories": ["education", "government", "productivity"],
  "shortcuts": [
    { "name": "Ask Uwazi", "short_name": "Ask", "url": "/ask", "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }] },
    { "name": "Voting Hub", "short_name": "Vote", "url": "/vote", "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }] },
    { "name": "Legislation", "short_name": "Bills", "url": "/legislation", "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }] }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://uwaziapp.uwazi.ai/manifest.json"
    }
  ],
  "prefer_related_applications": false,
  "screenshots": [
    {
      "src": "/screenshots/screenshot-home.png",
      "sizes": "1290x2796",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "UWAZI Home Dashboard"
    },
    {
      "src": "/screenshots/screenshot-vote.png",
      "sizes": "1290x2796",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Voting Hub — Your Candidates"
    },
    {
      "src": "/screenshots/screenshot-learn.png",
      "sizes": "1290x2796",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Civic Learning Tracks"
    },
    {
      "src": "/screenshots/screenshot-wide.png",
      "sizes": "2560x1600",
      "type": "image/png",
      "form_factor": "wide",
      "label": "UWAZI Desktop View"
    }
  ],
  "widgets": [
    {
      "name": "UWAZI Civic Widget",
      "description": "Quick access to your civic dashboard",
      "tag": "uwazi-widget",
      "ms_ac_template": "widget/ac-template.json",
      "data": "/widget/data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/screenshot-home.png",
          "sizes": "1290x2796",
          "label": "UWAZI Widget"
        }
      ],
      "icons": [
        {
          "src": "/icons/icon-96x96.png",
          "sizes": "96x96"
        }
      ],
      "backgrounds": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}